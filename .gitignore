# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
# mkdocs' site_dir since the docs moved to their own host. NOT covered by
# `dist/` above — that matches a path component named exactly "dist".
web/docs-dist/
# Oversized DuckDB bundles staged for R2 by vite.config.ts (build output).
web/r2-upload/
wheels/
*.egg-info

# Virtual environments
.venv

# Local, private Claude Code guidance (points at the private laterite-dev
# satellite; never committed — the public CLAUDE.md is the shared one).
CLAUDE.local.md

# Generated example output, and the gitignored working space CLAUDE.md points
# builds at.
output/

# AGS4 corpus-QA harness working dir (harvested share files + reports).
# Real-world deliveries may be confidential; never tracked.
corpus/

# ags4-forge evolutionary dogfood run dir (default --out-dir) +
# its cross-run confidence ledger. Regenerated; never tracked.
forge-runs/

# Rust build artifacts. `tools/build-rust.ps1` copies the final
# `lat-db` binary to `dist/` (which is already gitignored higher up).
# Cargo.lock IS tracked at rust-packages/ — the workspace pins
# transitive deps once for the whole tree. The broad `**/target/`
# also catches per-crate target dirs that linger from pre-workspace
# builds (e.g. `rust-packages/laterite-ags5-db/target/` left by a previous
# `cargo build --manifest-path laterite-ags5-db/Cargo.toml`).
rust-packages/target/
rust-packages/**/target/

# A root node_modules appears whenever npm is run from the repo root (tool
# caches like vitest's ride inside it, and those record machine-local paths).
# Anchored so the deliberate per-directory entries below stay the ones that
# speak for their own trees. Same class of fix as the wrangler cache (#511).
/node_modules/

# Web app (the AGS4 validator + explorer site). node_modules is npm's;
# src/wasm/ (tier 1), src/wasm-full/ (tier 2) and src/wasm-tokenizer/ (tier 0)
# are all generated by `wasm-pack build` (CI + local) from
# rust-packages/laterite-ags4-wasm and -tokenizer-wasm — never committed.
# web/dist/ is already covered by the global `dist/` entry above.
web/node_modules/
web/src/wasm/
web/src/wasm-full/
web/src/wasm-tokenizer/
# The docs Node-snippet gate (laterite-node/test/docs-examples.test.ts) drops a
# node_modules/laterite symlink beside the examples so their literal
# `import … from "laterite"` resolves to the local build — never committed.
web/docs-site/examples/node/node_modules/

# Claude Code local settings
.claude/

# Playwright scratch (root, when run from repo dir)
test-results/

# Coverage artifacts (pytest-cov / coverage.py, cargo-llvm-cov, vitest v8)
.coverage
.coverage.*
coverage.xml
htmlcov/
lcov.info
# cargo-llvm-cov writes rust.lcov / wasm.lcov next to the workspace root for the
# Codecov upload steps in nightly.yml — build artefacts, never committed.
*.lcov
web/coverage/
rust-packages/**/*.profraw

# python-ags4 parity oracle run log (parity.yml `tee`s it, check_parity.py reads
# it); regenerated per run, never committed.
parity.log
.DS_Store

# marimo session/cache snapshots
__marimo__/

# proptest saved-failure seeds — regenerated locally per run; not committed
# (consistent with the existing proptest suites, which commit none).
*.proptest-regressions

# cargo-mutants scratch output (the per-run mutation-sweep work dir).
mutants.out/
mutants.out.old/

# The changelog leak-gate's private denylist (tools/gen_changelog.py reads it):
# company names and other sensitive tokens that must never appear in the public
# CHANGELOG.md but also must not be committed here. Owner-maintained, local-only.
.changelog-denylist

# Scratch output from the docs CLI examples (web/docs-site/examples/cli/*.sh).
# Those scripts copy a fixture into place and run `lat` on it, so every
# gen_doc_outputs.py run — including the CI gate — drops these in the working
# tree. #225 swept them into the repo root with `git add -A`; they are build
# output, not sources. The examples' own inputs (examples/sample_site.ags) stay
# tracked; only what a run PRODUCES is ignored.
/delivery.ags
/repaired.ags
/restored.ags
/round-tripped.ags
/site.ags
/site.ags.idx
/site.ags.zst
/site.xlsx
/examples/merged.ags
/examples/phase2.ags
/examples/rev.ags
/examples/sample_site_typo.ags
/examples/sample_site_edition.ags

# The docs wasm examples import the PUBLISHED package name
# (`@laterite/ags4-wasm`) so a reader can copy one and have it work. A symlink
# here is what lets Node's resolver find the locally-built package —
# gen_doc_outputs.py drops it in, same trick as the node examples' symlink above.
web/docs-site/examples/wasm/node_modules/

# `wrangler` writes the Cloudflare account it resolved into `.wrangler/cache/`
# in whatever directory it ran from: the repo root when the R2 CORS config is
# reapplied by hand (that is the command deploy-validator.yml's failure message
# hands you, and its `--file` path is root-relative), `web/` when CI runs it.
# Unanchored so it catches both. Ignored rather than left loose because it
# names the account and `git add -A` is this repo's normal staging step — the
# same way #225 swept CLI scratch output into the root.
.wrangler/
