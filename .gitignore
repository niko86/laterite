# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local, private Claude Code guidance (points at the private laterite-dev
# satellite; never committed — the public CLAUDE.md is the shared one).
CLAUDE.local.md

# Generated example output
output/

# AGS4 corpus-QA harness working dir (harvested share files + reports).
# Real-world deliveries may be confidential; never tracked.
corpus/

# ags4-forge evolutionary dogfood run dir (default --out-dir) +
# its cross-run confidence ledger. Regenerated; never tracked.
forge-runs/

# Rust build artifacts. `tools/build-rust.ps1` copies the final
# `lat-db` binary to `dist/` (which is already gitignored higher up).
# Cargo.lock IS tracked at rust-packages/ — the workspace pins
# transitive deps once for the whole tree. The broad `**/target/`
# also catches per-crate target dirs that linger from pre-workspace
# builds (e.g. `rust-packages/laterite-ags5-db/target/` left by a previous
# `cargo build --manifest-path laterite-ags5-db/Cargo.toml`).
rust-packages/target/
rust-packages/**/target/

# Web app (the AGS4 validator + explorer site). node_modules is npm's;
# src/wasm/ + src/wasm-tokenizer/ are generated by `wasm-pack build` (CI +
# local) from rust-packages/laterite-ags4-wasm and -tokenizer-wasm — never
# committed. web/dist/ is already covered by the global `dist/` entry above.
web/node_modules/
web/src/wasm/
web/src/wasm-tokenizer/
# The docs Node-snippet gate (laterite-node/test/docs-examples.test.ts) drops a
# node_modules/laterite symlink beside the examples so their literal
# `import … from "laterite"` resolves to the local build — never committed.
web/docs-site/examples/node/node_modules/

# Claude Code local settings
.claude/

# Playwright scratch (root, when run from repo dir)
test-results/

# Coverage artifacts (pytest-cov / coverage.py, cargo-llvm-cov, vitest v8)
.coverage
.coverage.*
coverage.xml
htmlcov/
lcov.info
web/coverage/
rust-packages/**/*.profraw

# python-ags4 parity oracle run log (parity.yml `tee`s it, check_parity.py reads
# it); regenerated per run, never committed.
parity.log
.DS_Store

# marimo session/cache snapshots
__marimo__/

# proptest saved-failure seeds — regenerated locally per run; not committed
# (consistent with the existing proptest suites, which commit none).
*.proptest-regressions

# cargo-mutants scratch output (the per-run mutation-sweep work dir).
mutants.out/
mutants.out.old/

# The changelog leak-gate's private denylist (tools/gen_changelog.py reads it):
# company names and other sensitive tokens that must never appear in the public
# CHANGELOG.md but also must not be committed here. Owner-maintained, local-only.
.changelog-denylist
