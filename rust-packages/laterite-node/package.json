{
  "name": "laterite",
  "version": "0.12.0",
  "description": "AGS4 geotechnical data for Node.js — read, validate, produce, and query (the Node port of the laterite Python toolkit, Rust-backed).",
  "license": "MIT",
  "author": "niko86",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niko86/laterite.git",
    "directory": "rust-packages/laterite-node"
  },
  "homepage": "https://github.com/niko86/laterite#readme",
  "keywords": [
    "ags4",
    "ags",
    "geotechnical",
    "validator",
    "arrow",
    "napi",
    "rust"
  ],
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "lat": "./bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#native": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "dist",
    "bin.mjs",
    "index.js",
    "index.d.ts",
    "README.md",
    "README-cli.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "napi": {
    "binaryName": "laterite-node",
    "packageName": "@laterite/native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ],
    "enableDefaultTargets": false
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "napi build --platform --release && npm run build:ts",
    "build:debug": "napi build --platform && npm run build:ts",
    "build:ts": "tsup",
    "artifacts": "napi artifacts",
    "smoke:pack": "node tools/pack-smoke.mjs",
    "prepublish:napi": "napi pre-publish -t npm",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "bench:matrix": "node bench/perf-matrix.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip"
  },
  "dependencies": {
    "apache-arrow": "^21.1.0"
  },
  "peerDependencies": {
    "@duckdb/node-api": ">=1.5.5-0"
  },
  "peerDependenciesMeta": {
    "@duckdb/node-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.5-r.3",
    "@eslint/js": "^10.0.1",
    "@napi-rs/cli": "^3.7.2",
    "@types/node": "^26.0.1",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "knip": "^6.27.0",
    "prettier": "^3.9.5",
    "semver": "^7.8.5",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.8"
  }
}
