  "grading": [
    {
      "term": "fine/medium/coarse fractions",
      "definition": "Distribution of particle sizes within sands and gravels is described by stating the predominant size fractions present, using the fine/medium/coarse descriptors of Table 7.",
      "ref": "BS 5930:2015+A1:2020 Table 7 (clause 33.4.3)"
    },
    {
      "term": "conjunction 'and'",
      "definition": "Used between two predominant size fractions, e.g. 'fine and medium GRAVEL'; differentiates the predominant fractions present.",
      "ref": "BS 5930:2015+A1:2020 clause 33.4.3 NOTE 2"
    },
    {
      "term": "conjunction 'to'",
      "definition": "Used to indicate a range of sizes, e.g. 'fine to coarse SAND'.",
      "ref": "BS 5930:2015+A1:2020 clause 33.4.3 NOTE 2"
    },
    {
      "term": "no size adjective",
      "definition": "Absence of a fine/medium/coarse adjective means the fine, medium and coarse fractions are all present in roughly equal proportions.",
      "ref": "BS 5930:2015+A1:2020 clause 33.4.3 NOTE 2"
    },
    {
      "term": "well-graded (descriptive)",
      "definition": "A well-graded soil with sufficient fine grains to fill the spaces between coarse grains is described as a fine soil; with insufficient fine grains it is a coarse soil. Formal grading-curve terms (well graded / poorly graded / uniformly graded / gap-graded) are BS EN ISO 14688-2 classification terms, not Section 6 field-description vocabulary.",
      "ref": "BS 5930:2015+A1:2020 clause 33 (page 99 NOTE 2)"
    }
  ],
