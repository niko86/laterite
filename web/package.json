{
  "name": "ags4-validator-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Client-side AGS4 validator + data explorer (Rust wasm + SolidJS).",
  "scripts": {
    "sync-dict": "node scripts/sync-dict.mjs",
    "sync-samples": "node scripts/sync-samples.mjs",
    "sync-sensitive": "node scripts/sync-sensitive.mjs",
    "sync-rules": "node scripts/sync-rules.mjs",
    "sync-assets": "node scripts/sync-dict.mjs && node scripts/sync-samples.mjs && node scripts/sync-sensitive.mjs && node scripts/sync-rules.mjs",
    "predev": "npm run sync-assets",
    "dev": "vite",
    "prebuild": "npm run sync-assets",
    "build": "vite build",
    "build:wasm": "wasm-pack build ../rust-packages/laterite-ags4-wasm --target web --release --out-dir \"$PWD/src/wasm\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "@tanstack/solid-virtual": "^3.13.32",
    "@types/leaflet": "^1.9.21",
    "@types/proj4": "^2.19.0",
    "age-encryption": "0.3.0",
    "apache-arrow": "^21.1.0",
    "echarts": "^6.1.0",
    "leaflet": "^1.9.4",
    "proj4": "^2.20.9",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.8",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^2.11.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "apache-arrow": "$apache-arrow"
  }
}
